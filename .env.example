# Copy this to .env and fill in your real values. Never commit .env.
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Auth: 'demo' bypasses the login/2FA gate for prototyping; 'full' requires Supabase login + TOTP
AUTH_MODE=demo
DATABASE_URL=
# Cohere embeddings (used only by the explicit root `node ingest.js` command)
COHERE_API_KEY=
# DeepSeek RAG
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# JINA embeddings + reader (live RAG over docs/*.pdf)
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_READER_URL=https://r.jina.ai/
# Vector store for RAG chunks: 'pgvector' (default) or 'memory'
RAG_VECTOR_STORE=pgvector
# Jira (staff shift data)
JIRA_HOST=your-domain.atlassian.net
# Optional alias; JIRA_HOST takes precedence.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
# Read-only Jira SHIFT ↔ Supabase public.shifts verifier
SUPABASE_J_URL=
SUPABASE_J_SERVICE_ROLE_KEY=
# Vendor API
VENDOR_API_URL=
VENDOR_PUBLIC_KEY=
# Storage → pgvector sweep cadence (ms). Scans the `sop-library` bucket,
# indexes new/changed PDFs into rag_chunks, drops chunks for removed files.
RAG_STORAGE_SYNC_MS=300000
# Supabase Realtime (client-side): live invalidation of staff + budget queries.
# Leave blank to fall back to the existing polling.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Supabase Edge Function `ask-rag` (query-time RAG variant; see supabase/functions/ask-rag)
# Secrets are set server-side via `supabase secrets set`, not this file:
#   SUPABASE_URL, SUPABASE_ANON_KEY, JINA_API_KEY, JINA_EMBEDDING_MODEL,
#   DEEPSEEK_API_KEY, DEEPSEEK_MODEL
# The JINA/DEEPSEEK keys above are shared; DEEPSEEK_MODEL is the function's generation model.
DEEPSEEK_MODEL=deepseek-chat
