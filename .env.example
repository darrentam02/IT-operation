# Copy this to .env and fill in your real values. Never commit .env.
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Supabase Postgres pool (Replit: set as Deployment secret, not project secret)
SUPABASE_DATABASE_URL=
# Postgres pool TLS (Supabase pooler requires it; set to false only for plaintext local PG)
DB_CONNECT_TLS=true
# DeepSeek + JINA RAG
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# JINA AI (embeddings + Reader for the 3 PDFs in docs/)
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_READER_URL=https://r.jina.ai/
# Jira (staff shift data)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
# Set AUTH_MODE=demo only for a demo environment; it bypasses the TOTP gate.
AUTH_MODE=
# Vendor API
VENDOR_PUBLIC_KEY=

# Vector store for the RAG assistant: pgvector (Supabase, persisted) or memory.
RAG_VECTOR_STORE=pgvector


# Auth: 'demo' skips the 2FA login gate (prototyping only), 'full' requires Supabase login + TOTP.
AUTH_MODE=full
