modules = ["nodejs-20", "web", "postgresql-16"]

[run]
command = ["sh", "-lc", "pnpm run build:production && pnpm start"]

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
